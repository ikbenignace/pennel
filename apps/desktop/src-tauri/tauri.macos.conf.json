{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "dev.pennel.Pennel",
  "bundle": {
    "macOS": {
      "minimumSystemVersion": "14.4",
      "hardenedRuntime": true,
      "entitlements": "Pennel.entitlements",
      "infoPlist": "Info.plist"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pennel",
        "url": "index.html?window=workspace",
        "width": 980,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "zoomHotkeysEnabled": false,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ]
  }
}
