{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pennel",
  "version": "0.1.0",
  "identifier": "app.pennel.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Pennel",
        "url": "index.html",
        "width": 920,
        "height": 660,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Dicteren en meetingnotities",
    "longDescription": "Houd een toets ingedrukt om opgekuiste tekst in eender welke app te dicteren, en neem meetings op als transcript en notities.",
    "copyright": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "libwebkit2gtk-4.1-0",
          "gstreamer1.0-tools",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav",
          "pulseaudio-utils",
          "x11-utils",
          "wl-clipboard"
        ]
      }
    }
  }
}
